<Page x:Class="WfpApp.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WfpApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="AdminPage">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" 
                   Text="Admin Panel"
                   FontSize="18" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- BAL OLDAL: Felhasználók listája -->
        <ListBox x:Name="UsersListBox" 
                 Grid.Row="1" Grid.Column="0" 
                 Margin="0,10,10,10"
                 SelectionMode="Single"
                 Loaded="UsersListBox_Loaded"
                 SelectionChanged="UsersListBox_SelectionChanged"/>

        <!-- JOBB OLDAL: Műveletek és űrlap -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- GOMBOK -->
            <StackPanel Orientation="Horizontal" 
                        Grid.Row="0" 
                        HorizontalAlignment="Left" 
                        Margin="0,0,0,10">
                <Button x:Name="DeleteButton" Content="Törlés" Width="100" Margin="0,0,5,0" Click="DeleteButton_Click"/>
                <Button x:Name="EditButton" Content="Módosítás" Width="100" Margin="0,0,5,0" Click="EditButton_Click"/>
                <Button x:Name="AddButton" Content="Hozzáadás" Width="100" Margin="0,0,5,0" Click="AddButton_Click"/>
                <Button x:Name="ClearButton" Content="Tisztít" Width="100" Click="ClearButton_Click"/>
            </StackPanel>

            <!-- ADATMEZŐK -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Username:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,5,2"/>
                <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1" Height="28" Padding="4"/>

                <TextBlock Text="Full Name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,5,2"/>
                <TextBox x:Name="FullNameTextBox" Grid.Row="1" Grid.Column="1" Height="28" Padding="4"/>

                <TextBlock Text="Password:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,5,2"/>
                <PasswordBox x:Name="PasswordBox1" Grid.Row="2" Grid.Column="1" Height="28" Padding="4"/>

                <TextBlock Text="Confirm Password:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,5,2"/>
                <PasswordBox x:Name="PasswordBox2" Grid.Row="3" Grid.Column="1" Height="28" Padding="4"/>

                <TextBlock Text="Email:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,5,2"/>
                <TextBox x:Name="EmailTextBox" Grid.Row="4" Grid.Column="1" Height="28" Padding="4"/>
            </Grid>

            <!-- VISSZA GOMB -->
            <Button x:Name="BackButton"
                    Content="Vissza"
                    Width="100"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10"
                    Click="BackButton_Click"/>
        </Grid>
    </Grid>
</Page>
