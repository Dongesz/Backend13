<Page x:Class="WfpApp.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WfpApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
               Text="Login To Account"
               FontSize="18"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Width="280">
            <TextBlock Text="Username" Margin="0,4,0,4"/>
            <TextBox x:Name="UsernameTextBox"
                 Height="28"
                 Padding="4"
                 />

            <TextBlock Text="Password" Margin="0,10,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                     Height="28"
                     Padding="4"
                     />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" >
            <Button x:Name="LoginButton"
            Content="Register"
            Width="85"
            Height="32"
            Click="RegisterButton_Click"/>
            
            <Button x:Name="SubmitButton"
            Content="Login"
            Width="100"
            Height="32"
            Click="SubmitButton_Click"/>
        </StackPanel>

    </Grid>
</Page>
